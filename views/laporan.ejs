<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Laporan Keuangan - SM Laundry</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-50 min-h-screen text-slate-800">
  <!-- Navbar -->
  <nav class="bg-indigo-600 text-white shadow-lg sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between h-16 items-center">
      <div class="flex items-center space-x-3">
        <i class="fa-solid fa-shirt text-2xl"></i>
        <span class="font-bold text-xl tracking-tight">SM Laundry</span>
      </div>
      <div class="flex items-center space-x-6 text-sm font-medium">
        <a href="/dashboard" class="hover:text-indigo-200 transition"><i class="fa-solid fa-chart-line mr-1"></i> Beranda</a>
        <a href="/pos" class="hover:text-indigo-200 transition"><i class="fa-solid fa-cash-register mr-1"></i> POS Kasir</a>
        <a href="/master" class="hover:text-indigo-200 transition"><i class="fa-solid fa-database mr-1"></i> Master Data</a>
        <a href="/laporan" class="text-white border-b-2 border-white pb-1"><i class="fa-solid fa-file-invoice-dollar mr-1"></i> Laporan</a>
        <a href="/logout" class="bg-indigo-700 hover:bg-indigo-800 px-3 py-1.5 rounded-lg transition"><i class="fa-solid fa-right-from-bracket mr-1"></i> Logout</a>
      </div>
    </div>
  </nav>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    
    <div class="flex justify-between items-center">
      <div>
        <h1 class="text-2xl font-bold text-slate-900"><i class="fa-solid fa-file-invoice-dollar text-indigo-600 mr-2"></i> Laporan Keuangan</h1>
        <p class="text-slate-500 text-sm">Ringkasan pendapatan, omset berjangka, dan piutang pelanggan.</p>
      </div>
      <button onclick="window.print()" class="bg-slate-800 hover:bg-slate-900 text-white text-sm font-medium px-4 py-2 rounded-xl transition flex items-center space-x-2">
        <i class="fa-solid fa-print"></i>
        <span>Cetak Laporan</span>
      </button>
    </div>

    <!-- Ringkasan Statistik Laporan -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <!-- Harian -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Pendapatan Hari Ini</p>
          <p class="text-2xl font-extrabold text-emerald-600 mt-2">Rp <%= harian.toLocaleString('id-ID') %></p>
        </div>
        <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center text-xl">
          <i class="fa-solid fa-calendar-day"></i>
        </div>
      </div>

      <!-- Mingguan -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">7 Hari Terakhir</p>
          <p class="text-2xl font-extrabold text-indigo-600 mt-2">Rp <%= mingguan.toLocaleString('id-ID') %></p>
        </div>
        <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center text-xl">
          <i class="fa-solid fa-calendar-week"></i>
        </div>
      </div>

      <!-- Bulanan -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Bulan Ini</p>
          <p class="text-2xl font-extrabold text-purple-600 mt-2">Rp <%= bulanan.toLocaleString('id-ID') %></p>
        </div>
        <div class="w-12 h-12 bg-purple-50 text-purple-600 rounded-xl flex items-center justify-center text-xl">
          <i class="fa-solid fa-calendar-days"></i>
        </div>
      </div>

      <!-- Piutang -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Total Piutang</p>
          <p class="text-2xl font-extrabold text-rose-600 mt-2">Rp <%= piutang.toLocaleString('id-ID') %></p>
        </div>
        <div class="w-12 h-12 bg-rose-50 text-rose-600 rounded-xl flex items-center justify-center text-xl">
          <i class="fa-solid fa-hand-holding-dollar"></i>
        </div>
      </div>

    </div>

    <!-- Tabel Daftar Piutang Pelanggan -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
      <h2 class="text-lg font-semibold text-slate-800 mb-4 flex items-center">
        <i class="fa-solid fa-clock-rotate-left text-rose-500 mr-2"></i> Daftar Piutang Pelanggan (Belum Lunas)
      </h2>

      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left text-slate-600">
          <thead class="text-xs uppercase bg-slate-100 text-slate-500">
            <tr>
              <th class="px-4 py-3">No. Nota</th>
              <th class="px-4 py-3">Nama Pelanggan</th>
              <th class="px-4 py-3">No WhatsApp</th>
              <th class="px-4 py-3">Tanggal Masuk</th>
              <th class="px-4 py-3">Total Tagihan</th>
              <th class="px-4 py-3 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% if(listPiutang.length > 0) { %>
              <% listPiutang.forEach(p => { %>
                <tr class="hover:bg-slate-50">
                  <td class="px-4 py-3 font-semibold text-slate-800"><%= p.invoice_no %></td>
                  <td class="px-4 py-3"><%= p.customer_name %></td>
                  <td class="px-4 py-3 font-medium text-indigo-600"><%= p.phone %></td>
                  <td class="px-4 py-3"><%= p.date_entry %></td>
                  <td class="px-4 py-3 font-bold text-rose-600">Rp <%= p.total_amount.toLocaleString('id-ID') %></td>
                  <td class="px-4 py-3 text-right">
                    <a href="/nota/<%= p.id %>" class="bg-indigo-50 hover:bg-indigo-100 text-indigo-600 font-medium px-3 py-1.5 rounded-lg text-xs transition">Buka Nota</a>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="6" class="px-4 py-6 text-center text-slate-400">Tidak ada piutang saat ini (Semua transaksi lunas).</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</body>
</html>