<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Transaksi - SM Laundry</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-50 min-h-screen text-slate-800 flex items-center justify-center p-4">

  <div class="bg-white max-w-md w-full p-6 rounded-2xl shadow-md border border-slate-200 space-y-4">
    <div class="flex justify-between items-center border-b pb-3">
      <h2 class="text-lg font-bold text-slate-800">
        <i class="fa-solid fa-pen-to-square text-indigo-600 mr-2"></i> Edit Status Transaksi
      </h2>
      <span class="text-xs font-mono font-semibold bg-indigo-50 text-indigo-700 px-2.5 py-1 rounded-md">
        <%= transaction.invoice_no %>
      </span>
    </div>

    <form action="/transaksi/edit/<%= transaction.id %>" method="POST" class="space-y-4">
      
      <!-- Status Pembayaran -->
      <div>
        <label class="block text-xs font-semibold text-slate-600 mb-1">Status Pembayaran</label>
        <select name="payment_status" class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
          <option value="Belum Lunas" <%= transaction.payment_status === 'Belum Lunas' ? 'selected' : '' %>>Belum Lunas</option>
          <option value="Lunas" <%= transaction.payment_status === 'Lunas' ? 'selected' : '' %>>Lunas</option>
        </select>
      </div>

      <!-- Status Pengerjaan -->
      <div>
        <label class="block text-xs font-semibold text-slate-600 mb-1">Status Pengerjaan</label>
        <select name="status" class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
          <option value="Proses" <%= transaction.status === 'Proses' ? 'selected' : '' %>>Proses</option>
          <option value="Selesai" <%= transaction.status === 'Selesai' ? 'selected' : '' %>>Selesai</option>
          <option value="Diambil" <%= transaction.status === 'Diambil' ? 'selected' : '' %>>Diambil</option>
        </select>
      </div>

      <div class="flex justify-end space-x-2 pt-2">
        <a href="/master" class="px-4 py-2 bg-slate-200 text-slate-700 rounded-lg text-sm font-medium hover:bg-slate-300">Batal</a>
        <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700">Simpan Perubahan</button>
      </div>
    </form>
  </div>

</body>
</html>