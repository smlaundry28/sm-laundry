<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Master Data - SM Laundry</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-50 min-h-screen text-slate-800">
  <!-- Navbar -->
  <nav class="bg-indigo-600 text-white shadow-lg sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between h-16 items-center">
      <div class="flex items-center space-x-3">
        <i class="fa-solid fa-shirt text-2xl"></i>
        <span class="font-bold text-xl tracking-tight">SM Laundry</span>
      </div>
      <div class="flex items-center space-x-6 text-sm font-medium">
        <a href="/dashboard" class="hover:text-indigo-200 transition"><i class="fa-solid fa-chart-line mr-1"></i> Beranda</a>
        <a href="/pos" class="hover:text-indigo-200 transition"><i class="fa-solid fa-cash-register mr-1"></i> POS Kasir</a>
        <a href="/master" class="text-white border-b-2 border-white pb-1"><i class="fa-solid fa-database mr-1"></i> Master Data</a>
        <% if(currentUser.role === 'owner') { %>
          <a href="/laporan" class="hover:text-indigo-200 transition"><i class="fa-solid fa-file-invoice-dollar mr-1"></i> Laporan</a>
        <% } %>
        <a href="/logout" class="bg-indigo-700 hover:bg-indigo-800 px-3 py-1.5 rounded-lg transition"><i class="fa-solid fa-right-from-bracket mr-1"></i> Logout</a>
      </div>
    </div>
  </nav>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    
    <div class="flex justify-between items-center">
      <h1 class="text-2xl font-bold text-slate-900"><i class="fa-solid fa-database text-indigo-600 mr-2"></i> Pengelolaan Master Data</h1>
      <span class="text-sm bg-indigo-100 text-indigo-800 px-3 py-1 rounded-full font-medium">Role: <%= currentUser.role.toUpperCase() %></span>
    </div>

    <!-- 1. DATA PARFUM -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2 bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
        <h2 class="text-lg font-semibold text-slate-800 mb-4 flex items-center"><i class="fa-solid fa-spray-can text-pink-500 mr-2"></i> Daftar Aroma Parfum</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm text-left text-slate-600">
            <thead class="text-xs uppercase bg-slate-100 text-slate-500">
              <tr>
                <th class="px-4 py-3">ID</th>
                <th class="px-4 py-3">Nama Aroma</th>
                <th class="px-4 py-3 text-right">Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% parfums.forEach(p => { %>
                <tr class="hover:bg-slate-50">
                  <td class="px-4 py-3 font-medium">#<%= p.id %></td>
                  <td class="px-4 py-3 font-semibold text-slate-800"><%= p.name %></td>
                  <td class="px-4 py-3 text-right">
                    <% if(currentUser.role === 'owner') { %>
                      <a href="/master/delete/parfums/<%= p.id %>" onclick="return confirm('Hapus aroma ini?')" class="text-red-500 hover:text-red-700 font-medium text-xs"><i class="fa-solid fa-trash"></i> Hapus</a>
                    <% } else { %>
                      <span class="text-xs text-slate-400">-</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
        <h3 class="text-md font-semibold text-slate-800 mb-4"><i class="fa-solid fa-plus-circle text-indigo-600 mr-2"></i> Tambah Aroma Parfum</h3>
        <form action="/master/parfum/add" method="POST" class="space-y-4">
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Nama Aroma</label>
            <input type="text" name="name" placeholder="Contoh: Sakura, Ocean Fresh" required class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
          </div>
          <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2 rounded-lg text-sm transition">Simpan Parfum</button>
        </form>
      </div>
    </div>

    <!-- 2. DATA PEGAWAI & ADMIN (DENGAN EDIT & LIHAT PASSWORD) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2 bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
        <h2 class="text-lg font-semibold text-slate-800 mb-4 flex items-center"><i class="fa-solid fa-users text-blue-500 mr-2"></i> Daftar Pegawai & Admin</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm text-left text-slate-600">
            <thead class="text-xs uppercase bg-slate-100 text-slate-500">
              <tr>
                <th class="px-4 py-3">Nama</th>
                <th class="px-4 py-3">Username</th>
                <th class="px-4 py-3">Password</th>
                <th class="px-4 py-3">Role</th>
                <th class="px-4 py-3 text-right">Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% users.forEach((u, idx) => { %>
                <tr class="hover:bg-slate-50">
                  <td class="px-4 py-3 font-semibold text-slate-800"><%= u.name %></td>
                  <td class="px-4 py-3"><%= u.username %></td>
                  <td class="px-4 py-3 font-mono">
                    <div class="flex items-center space-x-2">
                      <input type="password" value="<%= u.password %>" id="pwd-<%= idx %>" readonly class="bg-transparent border-none outline-none w-24 text-xs">
                      <button type="button" onclick="togglePassword('<%= idx %>')" class="text-slate-400 hover:text-indigo-600 text-xs">
                        <i class="fa-solid fa-eye" id="eye-<%= idx %>"></i>
                      </button>
                    </div>
                  </td>
                  <td class="px-4 py-3">
                    <span class="px-2 py-0.5 rounded-full text-xs font-semibold <%= u.role === 'owner' ? 'bg-purple-100 text-purple-700' : 'bg-blue-100 text-blue-700' %>">
                      <%= u.role.toUpperCase() %>
                    </span>
                  </td>
                  <td class="px-4 py-3 text-right space-x-2">
                    <% if(currentUser.role === 'owner') { %>
                      <button onclick="editUser('<%= u.id %>', '<%= u.name %>', '<%= u.username %>', '<%= u.password %>', '<%= u.role %>')" class="text-indigo-600 hover:text-indigo-800 font-medium text-xs">
                        <i class="fa-solid fa-pen-to-square"></i> Edit
                      </button>
                      <% if(u.id !== currentUser.id) { %>
                        <a href="/master/delete/users/<%= u.id %>" onclick="return confirm('Hapus user ini?')" class="text-red-500 hover:text-red-700 font-medium text-xs"><i class="fa-solid fa-trash"></i> Hapus</a>
                      <% } %>
                    <% } else { %>
                      <span class="text-xs text-slate-400">-</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <% if(currentUser.role === 'owner') { %>
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
          <h3 class="text-md font-semibold text-slate-800 mb-4"><i class="fa-solid fa-user-plus text-indigo-600 mr-2"></i> Tambah Pegawai / Owner</h3>
          <form action="/master/user/add" method="POST" class="space-y-3">
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Nama Lengkap</label>
              <input type="text" name="name" required class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Username</label>
              <input type="text" name="username" required class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Password</label>
              <input type="text" name="password" required class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Role Jabatan</label>
              <select name="role" class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                <option value="pegawai">Pegawai Kasir</option>
                <option value="owner">Owner</option>
              </select>
            </div>
            <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-2 rounded-lg text-sm transition">Simpan User</button>
          </form>
        </div>
      <% } %>
    </div>

    <!-- 3. DATA LAYANAN LAUNDRY -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2 bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
        <h2 class="text-lg font-semibold text-slate-800 mb-4 flex items-center"><i class="fa-solid fa-list text-emerald-500 mr-2"></i> Daftar Layanan & Tarif</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm text-left text-slate-600">
            <thead class="text-xs uppercase bg-slate-100 text-slate-500">
              <tr>
                <th class="px-4 py-3">Kategori</th>
                <th class="px-4 py-3">Nama Layanan</th>
                <th class="px-4 py-3">Durasi</th>
                <th class="px-4 py-3">Harga</th>
                <th class="px-4 py-3 text-right">Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% services.forEach(s => { %>
                <tr class="hover:bg-slate-50">
                  <td class="px-4 py-3"><span class="bg-slate-100 text-slate-700 text-xs px-2 py-1 rounded-md font-semibold"><%= s.category %></span></td>
                  <td class="px-4 py-3 font-semibold text-slate-800"><%= s.name %></td>
                  <td class="px-4 py-3"><%= s.type_duration %></td>
                  <td class="px-4 py-3 font-medium text-emerald-600">Rp <%= s.price.toLocaleString('id-ID') %></td>
                  <td class="px-4 py-3 text-right">
                    <% if(currentUser.role === 'owner') { %>
                      <a href="/master/delete/services/<%= s.id %>" onclick="return confirm('Hapus layanan ini?')" class="text-red-500 hover:text-red-700 font-medium text-xs"><i class="fa-solid fa-trash"></i> Hapus</a>
                    <% } else { %>
                      <span class="text-xs text-slate-400">-</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <% if(currentUser.role === 'owner') { %>
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
          <h3 class="text-md font-semibold text-slate-800 mb-4"><i class="fa-solid fa-plus-circle text-indigo-600 mr-2"></i> Tambah Layanan Baru</h3>
          <form action="/master/service/add" method="POST" class="space-y-3">
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Kategori</label>
              <select name="category" class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                <option value="Kiloan">Kiloan</option>
                <option value="Satuan">Satuan</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Nama Layanan</label>
              <input type="text" name="name" placeholder="Cuci Komplit / Karpet" required class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Durasi Pengerjaan</label>
              <div class="grid grid-cols-2 gap-2">
                <input type="number" min="1" name="duration_value" placeholder="Contoh: 2" required class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                <select name="duration_unit" class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                  <option value="Hari">Hari</option>
                  <option value="Jam">Jam</option>
                </select>
              </div>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Harga (Rp)</label>
              <input type="number" name="price" placeholder="6000" required class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
            </div>
            <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2 rounded-lg text-sm transition">Simpan Layanan</button>
          </form>
        </div>
      <% } %>
    </div>

    <!-- 4. DATA PELANGGAN -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
      <!-- TABEL DAFTAR NOTA TRANSAKSI -->
<div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
  <h2 class="text-lg font-semibold text-slate-800 mb-4 flex items-center">
    <i class="fa-solid fa-file-invoice text-indigo-600 mr-2"></i> Daftar Nota Transaksi
  </h2>
  <div class="overflow-x-auto">
    <table class="w-full text-sm text-left text-slate-600">
      <thead class="text-xs uppercase bg-slate-100 text-slate-500">
        <tr class="text-xs uppercase bg-slate-100 text-slate-500">
  <th class="px-4 py-3">No. Nota</th>
  <th class="px-4 py-3">Pelanggan</th>
  <th class="px-4 py-3">Tgl Masuk</th>
  <th class="px-4 py-3">Total</th>
  <th class="px-4 py-3">Status Bayar</th>
  <th class="px-4 py-3">Status Kerja</th> <!-- 👈 Tambah ini -->
  <th class="px-4 py-3 text-right">Aksi</th>
</tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% transactions.forEach(t => { %>
          <tr class="hover:bg-slate-50">
            <td class="px-4 py-3 font-semibold text-indigo-600"><%= t.invoice_no %></td>
            <td class="px-4 py-3"><%= t.customer_name %></td>
            <td class="px-4 py-3"><%= t.date_entry %></td>
            <td class="px-4 py-3 font-medium">Rp <%= t.total_amount.toLocaleString('id-ID') %></td>
            <td class="px-4 py-3">
              <span class="px-2 py-0.5 rounded-full text-xs font-semibold <%= t.payment_status === 'Lunas' ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700' %>">
                <%= t.payment_status %>
              </span>
            </td>
            <!-- 👈 Tambah kolom status pengerjaan ini -->
<td class="px-4 py-3">
  <span class="px-2 py-0.5 rounded-full text-xs font-semibold <%= t.status === 'Selesai' ? 'bg-blue-100 text-blue-700' : (t.status === 'Diambil' ? 'bg-gray-100 text-gray-700' : 'bg-amber-100 text-amber-700') %>">
    <%= t.status || 'Proses' %>
  </span>
</td>
            <td class="px-4 py-3 text-right space-x-2">
              <a href="/nota/<%= t.id %>" class="text-blue-600 hover:text-blue-800 font-medium text-xs"><i class="fa-solid fa-print"></i> Cetak</a>
              <a href="/transaksi/edit/<%= t.id %>" class="text-indigo-600 hover:text-indigo-800 font-medium text-xs"><i class="fa-solid fa-pen-to-square"></i> Edit</a>
              <a href="/transaksi/delete/<%= t.id %>" onclick="return confirm('Hapus nota transaksi ini?')" class="text-red-500 hover:text-red-700 font-medium text-xs"><i class="fa-solid fa-trash"></i> Hapus</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
    </div>

  </div>

  <!-- Modal Edit User / Pegawai -->
  <div id="userModal" class="hidden fixed inset-0 bg-slate-900 bg-opacity-50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 max-w-md w-full space-y-4 shadow-xl">
      <h3 class="text-lg font-bold text-slate-800"><i class="fa-solid fa-user-pen text-indigo-600 mr-2"></i> Edit Data Pegawai / Admin</h3>
      <form id="editUserForm" method="POST" action="" class="space-y-3">
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">Nama Lengkap</label>
          <input type="text" id="editName" name="name" required class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">Username</label>
          <input type="text" id="editUsername" name="username" required class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">Password</label>
          <input type="text" id="editPassword" name="password" required class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">Role Jabatan</label>
          <select id="editRole" name="role" class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
            <option value="pegawai">Pegawai Kasir</option>
            <option value="owner">Owner</option>
          </select>
        </div>
        <div class="flex justify-end space-x-2 pt-2">
          <button type="button" onclick="closeUserModal()" class="px-4 py-2 bg-slate-200 text-slate-700 rounded-lg text-sm font-medium hover:bg-slate-300">Batal</button>
          <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700">Simpan Perubahan</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function togglePassword(index) {
      const input = document.getElementById(`pwd-${index}`);
      const eye = document.getElementById(`eye-${index}`);
      if (input.type === 'password') {
        input.type = 'text';
        eye.classList.remove('fa-eye');
        eye.classList.add('fa-eye-slash');
      } else {
        input.type = 'password';
        eye.classList.remove('fa-eye-slash');
        eye.classList.add('fa-eye');
      }
    }

    function editUser(id, name, username, password, role) {
      document.getElementById('editUserForm').action = `/master/user/edit/${id}`;
      document.getElementById('editName').value = name;
      document.getElementById('editUsername').value = username;
      document.getElementById('editPassword').value = password;
      document.getElementById('editRole').value = role;
      document.getElementById('userModal').classList.remove('hidden');
    }

    function closeUserModal() {
      document.getElementById('userModal').classList.add('hidden');
    }

    function viewHistory(customerId) {
      fetch(`/master/customer/${customerId}/history`)
        .then(res => res.json())
        .then(data => {
          let text = `Riwayat Transaksi: ${data.customer.name}\n-----------------------------------\n`;
          if(data.transactions.length === 0) {
            text += "Belum ada riwayat transaksi.";
          } else {
            data.transactions.forEach(t => {
              text += `- [${t.invoice_no}] Tgl: ${t.date_entry} | Total: Rp ${t.total_amount.toLocaleString('id-ID')} | Status: ${t.payment_status}\n`;
            });
          }
          alert(text);
        });
    }
  </script>
</body>
</html>