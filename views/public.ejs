<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SM Laundry - Semua Bisa</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased selection:bg-indigo-500 selection:text-white">

  <!-- Floating Navigation -->
  <header class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-slate-100 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 bg-gradient-to-tr from-indigo-600 to-violet-500 rounded-xl flex items-center justify-center text-white shadow-lg shadow-indigo-200">
          <i class="fa-solid fa-shirt text-lg"></i>
        </div>
        <div>
          <span class="text-xl font-extrabold bg-gradient-to-r from-indigo-600 to-violet-600 bg-clip-text text-transparent">SM Laundry</span>
          <span class="block text-[10px] font-bold text-indigo-500 tracking-widest uppercase -mt-1">Semua Bisa</span>
        </div>
      </div>
      
      <nav class="hidden md:flex items-center space-x-8 text-sm font-semibold text-slate-600">
        <a href="#fitur" class="hover:text-indigo-600 transition">Keunggulan</a>
        <a href="#layanan" class="hover:text-indigo-600 transition">Layanan</a>
        <a href="#cek-nota" class="hover:text-indigo-600 transition">Cek Status</a>
      </nav>

      <a href="/login" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm px-5 py-2.5 rounded-xl shadow-md shadow-indigo-200 hover:shadow-lg hover:shadow-indigo-300 transition-all duration-200 flex items-center space-x-2">
        <i class="fa-solid fa-user-lock text-xs"></i>
        <span>Login Staff</span>
      </a>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(45rem_50rem_at_top,theme(colors.indigo.100),white)] opacity-60"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-indigo-50 border border-indigo-100 text-indigo-600 text-xs font-bold uppercase tracking-wider mb-6 shadow-sm">
        <i class="fa-solid fa-sparkles"></i>
        <span>Tagline Utama: Semua Bisa</span>
      </span>
      
      <h1 class="text-4xl md:text-6xl font-extrabold text-slate-900 tracking-tight leading-tight max-w-4xl mx-auto">
        Layanan Laundry Profesional, <br>
        <span class="bg-gradient-to-r from-indigo-600 via-violet-600 to-pink-500 bg-clip-text text-transparent">Sebab Semua Bisa Cepat & Bersih!</span>
      </h1>
      
      <p class="mt-6 text-base md:text-lg text-slate-600 max-w-2xl mx-auto font-normal">
        Dari pakaian harian, bedcover, hingga sepatu kesayangan — serahkan pada SM Laundry. Kami siap melayani dengan standar kebersihan tinggi dan tepat waktu.
      </p>

      <!-- Widget Cek Nota Form -->
      <form onsubmit="checkStatus(event)" id="cek-nota" class="mt-10 max-w-xl mx-auto bg-white p-3 rounded-2xl shadow-xl shadow-indigo-100 border border-slate-100 flex flex-col sm:flex-row gap-2">
        <div class="relative flex-grow">
          <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
          <input type="text" id="notaInput" required placeholder="Masukkan Nomor Nota (Contoh: SML-1001)..." class="w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition">
        </div>
        <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm px-6 py-3 rounded-xl shadow-md shadow-indigo-200 transition-all flex items-center justify-center space-x-2 whitespace-nowrap">
          <span>Cek Status</span>
          <i class="fa-solid fa-arrow-right text-xs"></i>
        </button>
      </form>

      <!-- Container Result Status Nota (Default Hidden) -->
      <div id="statusResult" class="hidden mt-6 max-w-xl mx-auto bg-white p-6 rounded-2xl shadow-xl border border-indigo-100 text-left transition-all">
        <div class="flex justify-between items-center border-b pb-3 mb-4">
          <div>
            <span class="text-xs text-slate-400 block font-bold uppercase">Nomor Nota</span>
            <h3 class="text-lg font-extrabold text-indigo-600" id="resNotaNum">-</h3>
          </div>
          <span id="resBadge" class="px-3 py-1 text-xs font-bold rounded-full bg-amber-100 text-amber-700">Proses</span>
        </div>
        <div class="space-y-2 text-sm text-slate-600">
          <div class="flex justify-between">
            <span>Nama Pelanggan:</span>
            <span class="font-semibold text-slate-800" id="resCustomer">-</span>
          </div>
          <div class="flex justify-between">
            <span>Estimasi Selesai:</span>
            <span class="font-semibold text-slate-800" id="resFinishDate">-</span>
          </div>
          <div class="flex justify-between">
            <span>Status Pembayaran:</span>
            <span class="font-semibold" id="resPayment">-</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Keunggulan Section -->
  <section id="fitur" class="py-16 bg-white border-y border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900">Mengapa Memilih SM Laundry?</h2>
        <p class="text-slate-500 text-sm mt-2">Komitmen kami untuk memberikan perawatan terbaik bagi setiap helai pakaian Anda.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Card 1 -->
        <div class="p-8 rounded-2xl bg-slate-50 border border-slate-100/80 shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
          <div class="w-12 h-12 bg-indigo-600 text-white rounded-xl flex items-center justify-center text-xl shadow-lg shadow-indigo-200 mb-6">
            <i class="fa-solid fa-bolt"></i>
          </div>
          <h3 class="text-lg font-bold text-slate-800 mb-2">Proses Cepat & Tepat</h3>
          <p class="text-slate-600 text-sm leading-relaxed">Pilihan durasi kilat hingga reguler. Pakaian siap tepat waktu sesuai garansi estimasi kami.</p>
        </div>

        <!-- Card 2 -->
        <div class="p-8 rounded-2xl bg-slate-50 border border-slate-100/80 shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
          <div class="w-12 h-12 bg-violet-600 text-white rounded-xl flex items-center justify-center text-xl shadow-lg shadow-violet-200 mb-6">
            <i class="fa-solid fa-spray-can"></i>
          </div>
          <h3 class="text-lg font-bold text-slate-800 mb-2">Parfum Premium Tahan Lama</h3>
          <p class="text-slate-600 text-sm leading-relaxed">Pilihan aroma parfum eksklusif yang harum, tidak menyengat, dan tahan lama berhari-hari.</p>
        </div>

        <!-- Card 3 -->
        <div class="p-8 rounded-2xl bg-slate-50 border border-slate-100/80 shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
          <div class="w-12 h-12 bg-emerald-600 text-white rounded-xl flex items-center justify-center text-xl shadow-lg shadow-emerald-200 mb-6">
            <i class="fa-solid fa-shield-halved"></i>
          </div>
          <h3 class="text-lg font-bold text-slate-800 mb-2">Higienis & Terpisah</h3>
          <p class="text-slate-600 text-sm leading-relaxed">Satu mesin untuk satu pelanggan. Pakaian Anda dipastikan tidak tertukar maupun tercampur.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Layanan & Harga -->
  <section id="layanan" class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900">Daftar Layanan Favorit</h2>
        <p class="text-slate-500 text-sm mt-2">Harga transparan tanpa biaya tersembunyi. Karena di sini, <b>Semua Bisa!</b></p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <% if (services && services.length > 0) { %>
          <% services.forEach(s => { %>
            <div class="bg-white rounded-2xl p-8 border border-slate-200/80 shadow-lg hover:shadow-2xl transition-all duration-300 flex flex-col justify-between">
              <div>
                <div class="text-sm font-bold text-indigo-600 uppercase tracking-wider mb-2"><%= s.category %></div>
                <h3 class="text-xl font-bold text-slate-800"><%= s.name %></h3>
                <div class="my-4">
                  <span class="text-3xl font-extrabold text-slate-900">Rp <%= s.price.toLocaleString('id-ID') %></span>
                </div>
                <ul class="space-y-3 text-sm text-slate-600 border-t border-slate-100 pt-4 mb-6">
                  <li class="flex items-center"><i class="fa-solid fa-clock text-indigo-500 mr-2"></i> Estimasi Waktu: <b><%= s.type_duration %></b></li>
                  <li class="flex items-center"><i class="fa-solid fa-check text-indigo-500 mr-2"></i> Perawatan Bersih & Higienis</li>
                  <li class="flex items-center"><i class="fa-solid fa-check text-indigo-500 mr-2"></i> Bebas Pilih Parfum</li>
                </ul>
              </div>
              <a href="https://wa.me/<%= info.phone %>?text=Halo%20SM%20Laundry,%20saya%20ingin%20pesan%20layanan%20<%= encodeURIComponent(s.name) %>" 
                 target="_blank" 
                 class="w-full py-3 bg-slate-100 hover:bg-indigo-600 hover:text-white text-slate-700 font-bold text-center rounded-xl transition text-sm flex items-center justify-center gap-2">
                <i class="fa-brands fa-whatsapp text-lg"></i>
                <span>Pesan Sekarang</span>
              </a>
            </div>
          <% }) %>
        <% } else { %>
          <div class="col-span-full text-center text-slate-400 py-8">
            Belum ada data layanan di master data.
          </div>
        <% } %>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-slate-900 text-white py-12 border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center gap-6">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 bg-indigo-600 rounded-xl flex items-center justify-center text-white font-bold">
          <i class="fa-solid fa-shirt"></i>
        </div>
        <div>
          <p class="font-bold text-lg">SM Laundry</p>
          <p class="text-xs text-slate-400">Semua Bisa — Solusi Perawatan Pakaian Handal</p>
        </div>
      </div>

      <a href="https://wa.me/628123456789" target="_blank" class="inline-flex items-center space-x-2 bg-emerald-500 hover:bg-emerald-600 text-white font-semibold text-sm px-5 py-2.5 rounded-xl shadow-lg shadow-emerald-900/20 transition">
        <i class="fa-brands fa-whatsapp text-lg"></i>
        <span>Hubungi WhatsApp Kasir</span>
      </a>

      <p class="text-xs text-slate-500">&copy; 2026 SM Laundry. All rights reserved.</p>
    </div>
  </footer>

  <script>
    async function checkStatus(event) {
      event.preventDefault();
      const notaNum = document.getElementById('notaInput').value.trim();
      const resultBox = document.getElementById('statusResult');

      if (!notaNum) return;

      try {
        // Mengirim permintaan pencarian ke backend Express
        const response = await fetch(`/api/check-status/${encodeURIComponent(notaNum)}`);
        
        if (!response.ok) {
          alert('Nomor nota tidak ditemukan. Periksa kembali input Anda!');
          resultBox.classList.add('hidden');
          return;
        }

        const data = await response.json();

        // Mengisi data ke dalam UI
        document.getElementById('resNotaNum').innerText = data.nota_number || notaNum;
        document.getElementById('resCustomer').innerText = data.customer_name || '-';
        document.getElementById('resFinishDate').innerText = data.date_finish || '-';
        document.getElementById('resPayment').innerText = data.payment_status || '-';

        // Update badge warna status laundry
        const badge = document.getElementById('resBadge');
        badge.innerText = data.status || 'Diproses';
        if (data.status === 'Selesai') {
          badge.className = 'px-3 py-1 text-xs font-bold rounded-full bg-emerald-100 text-emerald-700';
        } else {
          badge.className = 'px-3 py-1 text-xs font-bold rounded-full bg-amber-100 text-amber-700';
        }

        resultBox.classList.remove('hidden');
      } catch (err) {
        console.error(err);
        alert('Terjadi kesalahan saat mengambil data nota.');
      }
    }
  </script>
</body>
</html>